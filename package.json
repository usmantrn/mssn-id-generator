{
  "name": "mssn-id-generator",
  "version": "1.0.0",
  "description": "MSSN FUTB Chapter – ID Card Generator System",
  "main": "api/server.js",
  "type": "module",
  "scripts": {
    "dev:api": "node api/server.js",
    "dev:ui": "vite --port 5174",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:seed": "node api/seed.js",
    "setup": "npm install && npx prisma generate && npx prisma db push && node api/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@vercel/blob": "^2.6.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "framer-motion": "^10.18.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sharp": "^0.35.3",
    "sonner": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.0"
  }
}
